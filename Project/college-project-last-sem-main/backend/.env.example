# MediMart Backend - Environment variables
# Copy to backend/.env and set real values.

# --- Database ---
# Used by application-dev.properties (MySQL)
DB_URL=jdbc:mysql://localhost:3306/medimart_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- JWT ---
JWT_SECRET=MediMartSecretKey2024SuperLongSecretKeyForJWTTokenGenerationAndValidation
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Uploads / Files ---
UPLOAD_DIR=./uploads/prescriptions

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOGGING_LEVEL=DEBUG

